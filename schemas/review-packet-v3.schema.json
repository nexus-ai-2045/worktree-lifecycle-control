{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus-ai.local/schemas/worktree-lifecycle/review-packet-v3.schema.json",
  "title": "Worktree lifecycle human review packet v3",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "recorded_at",
    "recorded_by",
    "valid_until",
    "action",
    "target",
    "executed",
    "candidate_count",
    "protected_or_unknown_count",
    "cleanup_candidates",
    "protected_or_unknown",
    "proposed_operations",
    "separate_approval_boundaries",
    "recommendation",
    "report_path"
  ],
  "properties": {
    "schema_version": {
      "const": "worktree-lifecycle-review/v3"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "const": "human_review_packet"
    },
    "target": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "executed": {
      "const": false
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "protected_or_unknown_count": {
      "type": "integer",
      "minimum": 0
    },
    "cleanup_candidates": {
      "type": "array",
      "items": {
        "$ref": "scan-report-v3.schema.json#/$defs/record"
      }
    },
    "protected_or_unknown": {
      "type": "array",
      "items": {
        "$ref": "scan-report-v3.schema.json#/$defs/record"
      }
    },
    "proposed_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "operation",
          "expected_head",
          "preconditions",
          "executed"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "operation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_head": {
            "type": [
              "string",
              "null"
            ]
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "executed": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    },
    "separate_approval_boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "report_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
